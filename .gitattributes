* text=auto eol=lf

# Force LF for shell and config files even on Windows checkouts
*.sh         text eol=lf
*.bash       text eol=lf
Makefile     text eol=lf
Dockerfile   text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf

# Treat lockfiles as text but skip from diff noise
package-lock.json -diff
bun.lock          -diff
poetry.lock       -diff

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.pdf  binary
