{
  "bundleId": "relational-prototype",
  "bundleName": "EPAS Prototype - Relational",
  "projectName": "EPAS Prototype",
  "description": "Prototype starter for relational-operational applications.",
  "primaryColor": "green",
  "pages": [
    { "name": "Dashboard", "path": "dashboard", "icon": "home", "description": "Prototype dashboard" },
    { "name": "Workspaces", "path": "workspaces", "icon": "folder", "description": "Projects and workspaces" },
    { "name": "Runs", "path": "runs", "icon": "chart-bar", "description": "Prototype runs and outputs" },
    { "name": "Settings", "path": "settings", "icon": "cog", "description": "Project settings" }
  ],
  "features": {
    "aiDisclosure": true,
    "darkMode": true,
    "multiTenant": false
  },
  "auth": {
    "defaultEmail": "admin@example.com",
    "defaultPassword": "password"
  },
  "branding": {
    "logoText": "Prototype",
    "tagline": "Ship fast, stay shaped like EPAS"
  },
  "epas": {
    "base_version": "2.0.0",
    "profile_version": "2.1.0",
    "lifecycle": "prototype",
    "audience": "internal_platform",
    "environment": "local_dev",
    "governance": "g0_exploratory",
    "infrastructure": "i0_local_compose",
    "data_model": "relational_operational",
    "delivery": "sdk_first",
    "architecture": "modular_monolith"
  },
  "stack": {
    "backend": "FastAPI",
    "frontend": "Next.js",
    "database": "PostgreSQL",
    "eventing": "DB-backed event log",
    "auth": "stubbed/local-dev",
    "storage": "LocalStack S3",
    "notes": "Matches the current shipped starter runtime."
  }
}
