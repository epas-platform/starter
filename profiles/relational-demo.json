{
  "bundleId": "relational-demo",
  "bundleName": "EPAS Demo - Relational",
  "projectName": "EPAS Demo",
  "description": "Demo starter for relational-operational applications.",
  "primaryColor": "teal",
  "pages": [
    { "name": "Dashboard", "path": "dashboard", "icon": "home", "description": "Demo dashboard" },
    { "name": "Scenarios", "path": "scenarios", "icon": "document", "description": "Scenario walkthroughs" },
    { "name": "Runs", "path": "runs", "icon": "chart-bar", "description": "Demo runs and outputs" },
    { "name": "Audit", "path": "audit", "icon": "users", "description": "Visible audit trail" },
    { "name": "Settings", "path": "settings", "icon": "cog", "description": "Project settings" }
